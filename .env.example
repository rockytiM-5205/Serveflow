# ServeFlow environment configuration
#
# Copy this file to ".env" in the repository root and replace the placeholders.
# ".env" is git-ignored. Never commit real secrets or credentials.
# Real environment variables always take precedence over values in ".env".

# Environment selection: development | testing | production
# If unset, ServeFlow defaults to production settings (the strictest).
DJANGO_ENV=development

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# (Avoid Django's get_random_secret_key() output in .env files: it can contain
# '#' and '$', which .env parsers treat specially.)
DJANGO_SECRET_KEY=change-me-generate-a-long-random-value

# Debug mode is OFF unless explicitly enabled. Use True only on your own machine.
DJANGO_DEBUG=False

# Comma-separated host names. Development falls back to localhost if empty.
# Production refuses to start if this is empty.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Self-service onboarding: lets people sign up and create restaurants in the dashboard.
# This file is a development template, so it is on here. Leave it False in production
# unless you want public sign-ups.
DJANGO_SELF_SERVICE=True

# Optional: path of the Django admin (platform administration). Use something
# non-obvious in production, e.g. DJANGO_ADMIN_URL=manage-7f3k/
# DJANGO_ADMIN_URL=admin/

# PostgreSQL (required for development, testing and production).
# The role needs the CREATEDB privilege so pytest can create "test_<POSTGRES_DB>".
POSTGRES_DB=serveflow
POSTGRES_USER=serveflow
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional, production only:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://orders.example.com
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_SSL_REDIRECT=True
# Set to True ONLY if a trusted reverse proxy sets X-Forwarded-Proto and strips
# it from client requests.
# DJANGO_TRUST_PROXY_SSL_HEADER=False
